{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "employees/splice/schema/output.json",
  "title": "SPLICE cut report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "employee",
    "version",
    "slug",
    "scene_id",
    "cut",
    "date",
    "dedupe_key",
    "status",
    "confidence",
    "approval_source",
    "cut_sheet",
    "total_runtime_s",
    "text_elements",
    "captions",
    "music",
    "renders",
    "instruction_attempts",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "employee": {
      "const": "splice"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "cut": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dedupe_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed",
        "escalated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "approval_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "manifest_sha",
        "clip_count",
        "all_clips_approved"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clip_count": {
          "type": "integer",
          "minimum": 1
        },
        "all_clips_approved": {
          "const": true,
          "description": "Structurally pinned. A report covering any unapproved clip cannot be written."
        }
      }
    },
    "cut_sheet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clip_id",
          "in_s",
          "out_s",
          "reason"
        ],
        "properties": {
          "clip_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "in_s": {
            "type": "number",
            "minimum": 0
          },
          "out_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "total_runtime_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "text_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "content",
          "frames",
          "source",
          "rendered_as_real_text"
        ],
        "properties": {
          "type": {
            "enum": [
              "title_card",
              "lower_third",
              "watermark",
              "intro_sting",
              "end_subscribe_sting",
              "caption"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "frames": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "source": {
            "enum": [
              "brand_token",
              "transcript_cue",
              "supplied_title"
            ]
          },
          "rendered_as_real_text": {
            "const": true,
            "description": "Structurally pinned. Text is emitted by code, never generated as pixels."
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "cue_count",
        "drift_exceeded_count",
        "max_drift_ms"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cue_count": {
          "type": "integer",
          "minimum": 0
        },
        "drift_exceeded_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_drift_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "music": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "track_id",
          "path",
          "licence_path",
          "licence_sha256",
          "licence_verified"
        ],
        "properties": {
          "track_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "licence_path": {
            "type": "string",
            "minLength": 1
          },
          "licence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "licence_verified": {
            "const": true,
            "description": "Structurally pinned. An unlicensed track cannot appear in a written report."
          }
        }
      }
    },
    "renders": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aspect",
          "path",
          "sha256",
          "duration_s",
          "size_bytes",
          "verified"
        ],
        "properties": {
          "aspect": {
            "enum": [
              "16x9",
              "9x16"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "size_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "verified": {
            "const": true,
            "description": "Structurally pinned. An unverified render is omitted from this array, never recorded as delivered."
          }
        }
      }
    },
    "instruction_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "locus",
          "quoted_text",
          "action_taken",
          "verdict_unaffected"
        ],
        "properties": {
          "source": {
            "enum": [
              "transcript_cue",
              "clip_manifest",
              "filename",
              "brand_asset",
              "licence_file",
              "other"
            ]
          },
          "locus": {
            "type": "string",
            "minLength": 1
          },
          "quoted_text": {
            "type": "string",
            "minLength": 1
          },
          "action_taken": {
            "enum": [
              "recorded_and_rendered_verbatim",
              "recorded_and_ignored",
              "recorded_and_halted"
            ]
          },
          "verdict_unaffected": {
            "const": true,
            "description": "Structurally pinned. An artifact claiming an injection changed the outcome is invalid and cannot be written."
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
